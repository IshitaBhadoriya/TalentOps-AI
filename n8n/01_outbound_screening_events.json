{
  "name": "TalentOps AI - 1 Outbound screening events",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "talentops-screening",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "o-webhook",
      "name": "Screening Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        260
      ],
      "webhookId": "talentops-screening-demo"
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const body = $input.first().json.body ?? {};\nconst allowed = ['Pending Review', 'Shortlisted', 'Further Review Required'];\nconst keys = ['candidate_id', 'job_id', 'status', 'timestamp'];\nconst extra = Object.keys(body).filter(k => !keys.includes(k));\nconst valid = Number.isInteger(body.candidate_id) && Number.isInteger(body.job_id)\n  && allowed.includes(body.status) && typeof body.timestamp === 'string'\n  && !isNaN(Date.parse(body.timestamp)) && extra.length === 0;\nreturn [{ json: valid\n  ? { valid: true, route: body.status, candidate_id: body.candidate_id, job_id: body.job_id, status: body.status, timestamp: body.timestamp }\n  : { valid: false, route: 'invalid', error: 'Invalid payload: expected exactly candidate_id (int), job_id (int), status (known review status), timestamp (ISO string)' } }];"
      },
      "id": "o-validate",
      "name": "Validate Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        260
      ]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.route }}",
        "rules": {
          "rules": [
            {
              "value2": "Shortlisted",
              "output": 0
            },
            {
              "value2": "Pending Review",
              "output": 1
            },
            {
              "value2": "Further Review Required",
              "output": 2
            },
            {
              "value2": "invalid",
              "output": 3
            }
          ]
        }
      },
      "id": "o-route",
      "name": "Route by Status",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        440,
        260
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "o-s1-a",
              "name": "notification_mode",
              "value": "TEST_ONLY until the Discord node is enabled",
              "type": "string"
            },
            {
              "id": "o-s1-b",
              "name": "notification_text",
              "value": "={{ '[TEST ONLY] Candidate #' + $json.candidate_id + ' / job #' + $json.job_id + ' was SHORTLISTED by a human reviewer at ' + $json.timestamp }}",
              "type": "string"
            },
            {
              "id": "o-s1-c",
              "name": "event_label",
              "value": "shortlisted",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "o-s1",
      "name": "Prepare Shortlisted Notice",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        700,
        80
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "o-s2-a",
              "name": "notification_mode",
              "value": "TEST_ONLY until the Discord node is enabled",
              "type": "string"
            },
            {
              "id": "o-s2-b",
              "name": "notification_text",
              "value": "={{ '[TEST ONLY] Candidate #' + $json.candidate_id + ' / job #' + $json.job_id + ' is awaiting recruiter review at ' + $json.timestamp }}",
              "type": "string"
            },
            {
              "id": "o-s2-c",
              "name": "event_label",
              "value": "pending_review",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "o-s2",
      "name": "Prepare Pending Notice",
