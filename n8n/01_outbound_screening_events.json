      "typeVersion": 3.4,
      "position": [
        700,
        260
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "o-s3-a",
              "name": "notification_mode",
              "value": "TEST_ONLY until the Discord node is enabled",
              "type": "string"
            },
            {
              "id": "o-s3-b",
              "name": "notification_text",
              "value": "={{ '[TEST ONLY] Candidate #' + $json.candidate_id + ' / job #' + $json.job_id + ' needs FURTHER REVIEW at ' + $json.timestamp }}",
              "type": "string"
            },
            {
              "id": "o-s3-c",
              "name": "event_label",
              "value": "further_review",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "o-s3",
