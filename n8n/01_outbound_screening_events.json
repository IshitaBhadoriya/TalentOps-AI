      ]
    },
    {
      "parameters": {
        "content": "OUTBOUND: TalentOps AI -> n8n. Receives only {candidate_id, job_id, status, timestamp}. Any extra field (e.g. an email) is rejected on purpose. The Discord node is DISABLED by default: paste your webhook URL and enable it to get a real notification.",
        "height": 140,
        "width": 420
      },
      "id": "o-note",
      "name": "Note o-note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
