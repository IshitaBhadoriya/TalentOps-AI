# Copy to .env (cp .env.example .env  /  Copy-Item .env.example .env). Never commit .env.

# Optional n8n webhook. Leave empty to disable (the app works fine without n8n).
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/talentops-screening
N8N_WEBHOOK_URL=
N8N_TIMEOUT_SECONDS=3

# auto = try MiniLM embeddings, fall back to TF-IDF | embedding = require MiniLM | tfidf = never load the model
TALENTOPS_EMBEDDING_BACKEND=auto

TALENTOPS_MAX_UPLOAD_MB=5
# TALENTOPS_DB_PATH=data/talentops.db
